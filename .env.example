# Configuration BackZo Backend

# Port du serveur
PORT=3000

# Clé secrète Stripe (JAMAIS la clé publique !)
# Récupérez-la sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI

# Secret pour les webhooks Stripe (optionnel)
# Récupérez-le sur https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:8080

# MongoDB (optionnel - si non configuré, utilise des fichiers JSON)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Ou pour MongoDB local: mongodb://localhost:27017/backzo
MONGODB_URI=

# Authentification Admin
# Nom d'utilisateur admin
ADMIN_USERNAME=admin
# Mot de passe admin (sera hashé automatiquement)
ADMIN_PASSWORD=VotreMotDePasseSecurise2024!
# Secret JWT pour les tokens (générez une chaîne aléatoire longue)
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici

# Configuration Email (pour l'envoi de devis et notifications)
# Serveur SMTP
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=465
# Identifiants email
EMAIL_USER=team@backzo.eu
EMAIL_PASS=votre_mot_de_passe_email
# Adresses d'envoi et de réception
EMAIL_FROM=team@backzo.eu
EMAIL_TO=team@backzo.eu
